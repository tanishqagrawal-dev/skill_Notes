# Netlify HTTP Cache Control Headers

# HTML pages - Never cache stale HTML
/*.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/pages/*.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# JavaScript & CSS files - Revalidate with server on deploy
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Static media & fonts - Cache long term
/assets/*
  Cache-Control: public, max-age=31536000, immutable
