{
    "storage": {
        "rules": "storage.rules"
    },
    "functions": {
        "source": "functions"
    },
    "firestore": {
        "rules": "firestore.rules"
    },
    "hosting": {
        "public": "dist",
        "cleanUrls": true,
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "server/**",
            "scripts/**",
            "functions/**/*.js.map"
        ],
        "rewrites": [
            {
                "source": "/login",
                "destination": "/pages/auth.html"
            },
            {
                "source": "/auth",
                "destination": "/pages/auth.html"
            },
            {
                "source": "/pages/login",
                "destination": "/pages/auth.html"
            },
            {
                "source": "/pages/auth/**",
                "destination": "/pages/auth.html"
            },
            {
                "source": "/pages/codetantra/**",
                "destination": "/pages/codetantra.html"
            },
            {
                "source": "/notes/**",
                "destination": "/pages/notes.html"
            },
            {
                "source": "/pages/dashboard/**",
                "destination": "/pages/dashboard.html"
            }
        ],
        "headers": [
            {
                "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|woff2)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            },
            {
                "source": "**/*.@(css|js)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            }
        ]
    }
}